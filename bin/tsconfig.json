{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": false,
    "rootDir": "../",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["../src/**/*.ts", "./**/*.ts"],
  "exclude": ["../src/**/*.test.ts"]
}
