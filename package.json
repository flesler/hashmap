{
  "name": "hashmap",
  "version": "3.0.0",
  "description": "HashMap Class for JavaScript",
  "keywords": [
    "hashmap",
    "map",
    "object",
    "array",
    "associative",
    "javascript",
    "nodejs",
    "node",
    "browser"
  ],
  "author": {
    "name": "Ariel Flesler",
    "url": "https://github.com/flesler"
  },
  "license": "MIT",
  "homepage": "https://github.com/flesler/hashmap",
  "bugs": "https://github.com/flesler/hashmap/issues",
  "repository": "git://github.com/flesler/hashmap",
  "type": "module",
  "main": "./dist/hashmap.cjs",
  "module": "./dist/hashmap.js",
  "types": "./dist/hashmap.d.ts",
  "exports": {
    ".": {
      "types": "./dist/hashmap.d.ts",
      "import": "./dist/hashmap.js",
      "require": "./dist/hashmap.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint --cache --cache-strategy content 'src/**/*.ts' '*.ts'",
    "lint:fix": "npm run lint -- --fix",
    "benchmark": "npm run build && tsx bin/benchmark.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@stylistic/eslint-plugin": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.21.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
